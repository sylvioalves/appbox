# Editor settings for every file in the repository.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{js,css,html,json,yml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
