#!/bin/sh
# Removes the AppArmor profile that postinst installed.
set -e

if [ "$1" = remove ] || [ "$1" = purge ]; then
  if [ -f /etc/apparmor.d/appbox ]; then
    if command -v apparmor_parser >/dev/null 2>&1 && [ -d /sys/kernel/security/apparmor ]; then
      apparmor_parser --remove /etc/apparmor.d/appbox >/dev/null 2>&1 || true
    fi
    rm -f /etc/apparmor.d/appbox
  fi
fi
